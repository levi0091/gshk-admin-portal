# G-FlowDesk Admin Portal — backend environment
#
# Copy to backend/.env and fill in real values. NEVER commit backend/.env.
# Every value below is a placeholder; none of them is a working secret.
#
# On Railway these are service variables, set once per service (DEV and PROD
# are separate services with separate values — no shared secrets).

# ---------------------------------------------------------------------------
# Deployment identity
# ---------------------------------------------------------------------------
# Which deployment this process is. Set to exactly "dev" or "prod".
# This is the single switch that tells the app which TPSI environment to use
# (see the TPSI block below) — there is no second variable to keep in sync.
APP_ENV=dev

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Alembic and the TPSI advisory lock connect over this DSN.
# Use the POOLER host, not db.<ref>.supabase.co — the direct host is
# IPv6-only and unreachable from IPv4-only networks (including CI and most
# office/home connections). The pooler username is postgres.<project_ref>.
DATABASE_URL=postgresql://postgres.<project_ref>:<password>@aws-1-ap-northeast-1.pooler.supabase.com:5432/postgres

# Supabase REST — the app's normal data path.
SUPABASE_URL=https://<project_ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# ---------------------------------------------------------------------------
# HTTP
# ---------------------------------------------------------------------------
# Comma-separated. DEV: https://admin-dev.g-flowdesk.com
#                 PROD: https://admin.g-flowdesk.com
ALLOWED_ORIGINS=http://localhost:5173

# ---------------------------------------------------------------------------
# Third-party services
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=<anthropic-api-key>

# Resend — transactional mail, sent from no-reply@getstarted.hk.
RESEND_API_KEY=<resend-api-key>

# There is NO variable for where non-production mail goes. Levi 2026-08-30:
# whenever APP_ENV is not exactly 'prod', every message is delivered to the
# fixed list in services/email_service.py (TEST_RECIPIENTS) and to nobody else.
# This database carries real client and director addresses, so that had to be
# impossible rather than merely configured. EMAIL_REDIRECT_TO used to do this
# job and has been removed — setting it now does nothing.

# EMAIL_TRANSPORT=console stubs mail out entirely — the message is written to
# stderr and NOTHING is delivered, not even to the test recipients. With a safe
# destination now compiled in, this is no longer needed to protect clients; it
# remains because RESEND_API_KEY is still a placeholder in the local .env, so
# 'resend' has nothing to authenticate with. Every send made this way is
# audited with transport='console' so it can never be read as a delivery, and
# it is REFUSED when APP_ENV=prod. Remove it once a real Resend key is in place.
# EMAIL_TRANSPORT=console

# ---------------------------------------------------------------------------
# TPSI (Companies Registry SOAP API)
# ---------------------------------------------------------------------------
# TPSI_ENV is normally NOT set: APP_ENV picks it.
#     APP_ENV=dev   -> TPSI test  (apitest.cr.gov.hk)
#     APP_ENV=prod  -> TPSI prod  (e-services.cr.gov.hk)
#
# Set TPSI_ENV only to override that deliberately. The one case that needs it
# is the pilot: PROD running against TPSI test before GSHK is ready to spend
# real money on live filings. Then, and only then:
#     APP_ENV=prod
#     TPSI_ENV=test
#
# APP_ENV=dev with TPSI_ENV=prod is refused outright — submitFormNar1 is
# chargeable and irreversible, and a dev deployment must never file for real.
# TPSI_ENV=

# CR's endpoint for the chosen environment. The app refuses a crossed pair
# (test env pointing at the production host, or the reverse).
#   TPSI test: https://apitest.cr.gov.hk/ICRIS3EF
#   TPSI prod: [PROD_URL]   <- fill in at PROD cutover; not needed before then
TPSI_BASE_URL=https://apitest.cr.gov.hk/ICRIS3EF

# The TEST host serves a self-signed certificate, so verification is off there.
# Ignored when the TPSI environment is prod — verification is forced on and
# cannot be switched off by an env var.
TPSI_TLS_VERIFY=false

# Fernet key encrypting stored TPSI passwords and access tokens at rest.
# Generate with:  python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# DEV and PROD must have DIFFERENT keys. Rotating this key makes every stored
# credential and token undecryptable — users must re-enter their passwords.
TPSI_CRED_KEY=<fernet-key>

# CR's public key, used to encrypt the PIN-signing payload. NOT in this repo:
# *.pem and docs/ are both gitignored, so a fresh clone or CI checkout has no
# key file. The deployed mechanism is the inline PEM below — Railway holds the
# value directly. TEST and PROD are DIFFERENT keys; the source is §7.4 of
# docs/TPSI API Interface v1.0.14.docx. Never commit either one.
# (Railway's UI may store multi-line values with literal \n escapes — that is
# handled, paste it either way.)
TPSI_CR_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n<base64>\n-----END PUBLIC KEY-----\n"

# Local-dev alternative to the inline key, for whoever already has the file on
# disk. Set one or the other; the inline value wins if both are present.
# TPSI_CR_PUBLIC_KEY_PATH=docs/tpsi/cr_public_test.pem

# ---------------------------------------------------------------------------
# Local-only — not needed on Railway
# ---------------------------------------------------------------------------
# One real CR presenter account, used ONLY by backend/scripts/tpsi_smoke_test.py
# to check connectivity by hand. CR locks accounts after repeated auth
# failures, so that script makes exactly one login attempt. Runtime credentials
# are per-user rows in the database, never environment variables.
TPSI_SMOKE_ACCOUNT_NO=<presenter-account>
TPSI_SMOKE_USER_ID=<e-registry-user-id>
TPSI_SMOKE_PASSWORD=<password>

# Viewpoint (the legacy system) — read-only source for the ETL. Not used by
# the running API.
VIEWPOINT_SERVER=<sql-server-host>
VIEWPOINT_DATABASE=<database-name>
