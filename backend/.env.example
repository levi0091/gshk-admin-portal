SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret
ALLOWED_ORIGINS=https://admin-dev.g-flowdesk.com,http://localhost:5173
DATABASE_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres

# Email
RESEND_API_KEY=your-resend-api-key

# AI
ANTHROPIC_API_KEY=your-anthropic-api-key

# TPSI (HK Govt API — stored in Railway env vars only, never hardcode)
TPSI_USERNAME=your-tpsi-username
TPSI_PASSWORD=your-tpsi-password
TPSI_ACCOUNT_ID=your-tpsi-account-id

# Alembic (same as DATABASE_URL but named separately for alembic.ini)
SQLALCHEMY_DATABASE_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres
